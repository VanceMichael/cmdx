diff --git a/pkg/config/include.go b/pkg/config/include.go
new file mode 100644
index 0000000..b7b1dce
--- /dev/null
+++ b/pkg/config/include.go
@@ -0,0 +1,165 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/suzuki-shunsuke/cmdx/pkg/domain"
+	"github.com/suzuki-shunsuke/cmdx/pkg/validate"
+	"go.yaml.in/yaml/v3"
+)
+
+// Load reads the root configuration file and all configuration files that are
+// referenced via "includes" recursively, and merges their tasks into one
+// configuration.
+//
+// Include paths are resolved relative to the directory of the configuration
+// file that declares them. Files are identified by their normalized real paths,
+// so the same file is loaded only once and cyclic includes are detected.
+// Tasks are merged in the depth-first order of includes: the tasks of each
+// included file come first, followed by the tasks declared in the current file.
+//
+// The whole include graph is read, parsed, initialized with file level
+// default values, and validated before the merged configuration is returned.
+// If any error occurs, no partially built configuration is returned.
+func (client *Client) Load(rootPath string) (*domain.Config, error) {
+	l := &loader{
+		loaded: map[string]*loadedConfig{},
+	}
+	root, _, err := l.load(rootPath, "", nil, nil)
+	if err != nil {
+		return nil, err
+	}
+
+	cfg := root.raw
+	cfg.Tasks = root.tasks
+	if err := validate.Config(cfg); err != nil {
+		return nil, fmt.Errorf("please fix the configuration file: %w", err)
+	}
+	return cfg, nil
+}
+
+type loadedConfig struct {
+	raw   *domain.Config
+	tasks []domain.Task
+}
+
+type loader struct {
+	// loaded caches configuration files that have been already processed,
+	// keyed by their normalized real paths.
+	loaded map[string]*loadedConfig
+}
+
+// load reads one configuration file and returns it together with the merged
+// task list of its include sub graph.
+//
+// included is false when the file was already loaded through another include
+// path, in which case the caller must not append its tasks again.
+//
+// declaredPath is the include path written in the parent configuration file.
+// baseDir is the directory of the parent configuration file and is empty only
+// for the root configuration file. chain and realChain represent the include
+// chain from the root file to the parent file, by apparent paths and
+// normalized real paths respectively.
+func (l *loader) load(
+	declaredPath, baseDir string, chain, realChain []string,
+) (lc *loadedConfig, included bool, err error) {
+	apparentPath := declaredPath
+	if baseDir != "" && !filepath.IsAbs(apparentPath) {
+		// Relative include paths are resolved from the directory of the
+		// file that declares them; absolute paths are used as-is.
+		apparentPath = filepath.Join(baseDir, declaredPath)
+	}
+	abs, err := filepath.Abs(filepath.Clean(apparentPath))
+	if err != nil {
+		return nil, false, fmt.Errorf("failed to resolve the configuration file path %q: %w", apparentPath, err)
+	}
+	fileChain := append(append([]string{}, chain...), abs)
+
+	b, err := os.ReadFile(abs)
+	if err != nil {
+		return nil, false, fmt.Errorf(
+			"failed to read the configuration file %s: %w\ninclude chain: %s",
+			abs, err, strings.Join(fileChain, " -> "))
+	}
+
+	var raw domain.Config
+	if err := yaml.Unmarshal(b, &raw); err != nil {
+		return nil, false, fmt.Errorf(
+			"failed to parse the configuration file. the configuration file is invalid: %s: %w\ninclude chain: %s",
+			abs, err, strings.Join(fileChain, " -> "))
+	}
+
+	// Identify files by the normalized real path so that different include
+	// paths pointing at the same file (e.g. via symlinks) are recognized as
+	// one file for de-duplication and cycle detection.
+	realPath, err := filepath.EvalSymlinks(abs)
+	if err != nil {
+		return nil, false, fmt.Errorf(
+			"failed to resolve the real path of the configuration file %s: %w\ninclude chain: %s",
+			abs, err, strings.Join(fileChain, " -> "))
+	}
+
+	for _, p := range realChain {
+		if p == realPath {
+			return nil, false, fmt.Errorf(
+				"a cyclic configuration include is detected:\ninclude chain: %s",
+				formatIncludeChain(
+					fileChain,
+					append(append([]string{}, realChain...), realPath)))
+		}
+	}
+
+	if cached, ok := l.loaded[realPath]; ok {
+		// The same file was already included and processed at an earlier
+		// position in the depth-first traversal.
+		return cached, false, nil
+	}
+
+	// Apply the file level default values only to the tasks that this file
+	// declares. They must never leak to tasks declared in sibling files.
+	if err := setupConfig(&raw); err != nil {
+		return nil, false, fmt.Errorf(
+			"please fix the configuration file: %w\ninclude chain: %s",
+			err, strings.Join(fileChain, " -> "))
+	}
+	dir := filepath.Dir(abs)
+	setWorkingDir(raw.Tasks, dir)
+
+	childRealChain := append(append([]string{}, realChain...), realPath)
+	tasks := []domain.Task{}
+	for _, inc := range raw.Includes {
+		child, childIncluded, err := l.load(inc, dir, fileChain, childRealChain)
+		if err != nil {
+			return nil, false, err
+		}
+		if childIncluded {
+			tasks = append(tasks, child.tasks...)
+		}
+	}
+	tasks = append(tasks, raw.Tasks...)
+
+	lc = &loadedConfig{
+		raw:   &raw,
+		tasks: tasks,
+	}
+	l.loaded[realPath] = lc
+	return lc, true, nil
+}
+
+// formatIncludeChain renders the include chain from the root file to the
+// failing file. paths and realPaths are aligned apparent paths and normalized
+// real paths. When they differ (for example because a path contains a
+// symlink), the real path is annotated so that cycle detection is auditable.
+func formatIncludeChain(paths, realPaths []string) string {
+	arr := make([]string, len(paths))
+	for i, p := range paths {
+		arr[i] = p
+		if i < len(realPaths) && realPaths[i] != p {
+			arr[i] += " (real path: " + realPaths[i] + ")"
+		}
+	}
+	return strings.Join(arr, " -> ")
+}
diff --git a/pkg/config/include_test.go b/pkg/config/include_test.go
new file mode 100644
index 0000000..fb4f0c2
--- /dev/null
+++ b/pkg/config/include_test.go
@@ -0,0 +1,491 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/suzuki-shunsuke/cmdx/pkg/domain"
+)
+
+func writeFile(t *testing.T, p string, content string) {
+	t.Helper()
+	require.NoError(t, os.MkdirAll(filepath.Dir(p), 0o755))
+	require.NoError(t, os.WriteFile(p, []byte(content), 0o644))
+}
+
+func taskNames(tasks []domain.Task) []string {
+	names := make([]string, 0, len(tasks))
+	for _, task := range tasks {
+		names = append(names, task.Name)
+	}
+	return names
+}
+
+func findTask(t *testing.T, tasks []domain.Task, name string) domain.Task {
+	t.Helper()
+	for _, task := range tasks {
+		if task.Name == name {
+			return task
+		}
+	}
+	t.Fatalf("task %q is not found: %v", name, taskNames(tasks))
+	return domain.Task{}
+}
+
+func TestLoad_noIncludes(t *testing.T) {
+	dir := t.TempDir()
+	root := filepath.Join(dir, "cmdx.yaml")
+	writeFile(t, root, `---
+tasks:
+- name: hello
+  script: echo hello
+`)
+
+	cfg, err := New().Load(root)
+	require.NoError(t, err)
+	require.Len(t, cfg.Tasks, 1)
+	task := cfg.Tasks[0]
+	assert.Equal(t, "hello", task.Name)
+	assert.Equal(t, defaultTimeout, task.Timeout.Duration)
+	assert.Equal(t, dir, task.WorkingDir)
+}
+
+func TestLoad_depthFirstOrder(t *testing.T) {
+	dir := t.TempDir()
+	root := filepath.Join(dir, "cmdx.yaml")
+	writeFile(t, root, `---
+includes:
+- a.yaml
+- b.yaml
+tasks:
+- name: root1
+  script: echo root
+`)
+	writeFile(t, filepath.Join(dir, "a.yaml"), `---
+includes:
+- c.yaml
+tasks:
+- name: a1
+  script: echo a
+`)
+	writeFile(t, filepath.Join(dir, "b.yaml"), `---
+tasks:
+- name: b1
+  script: echo b
+`)
+	writeFile(t, filepath.Join(dir, "c.yaml"), `---
+tasks:
+- name: c1
+  script: echo c
+`)
+
+	cfg, err := New().Load(root)
+	require.NoError(t, err)
+	// Each included file's tasks come first in DFS order, then the current
+	// file's tasks.
+	assert.Equal(t, []string{"c1", "a1", "b1", "root1"}, taskNames(cfg.Tasks))
+}
+
+func TestLoad_nestedIncludeRelativePathAndWorkingDir(t *testing.T) {
+	dir := t.TempDir()
+	root := filepath.Join(dir, "cmdx.yaml")
+	writeFile(t, root, `---
+includes:
+- sub/a.yaml
+tasks:
+- name: root1
+  script: echo root
+`)
+	writeFile(t, filepath.Join(dir, "sub", "a.yaml"), `---
+includes:
+- deep/c.yaml
+tasks:
+- name: a1
+  script: echo a
+- name: group
+  tasks:
+  - name: nested
+    script: echo nested
+`)
+	writeFile(t, filepath.Join(dir, "sub", "deep", "c.yaml"), `---
+tasks:
+- name: c1
+  script: echo c
+`)
+
+	cfg, err := New().Load(root)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"c1", "a1", "group", "root1"}, taskNames(cfg.Tasks))
+
+	// Include paths are resolved relative to the directory of the file that
+	// declares them, and tasks run in the declaring file's directory by
+	// default. Nested tasks inherit the directory too.
+	assert.Equal(t, filepath.Join(dir, "sub", "deep"), findTask(t, cfg.Tasks, "c1").WorkingDir)
+	assert.Equal(t, filepath.Join(dir, "sub"), findTask(t, cfg.Tasks, "a1").WorkingDir)
+	group := findTask(t, cfg.Tasks, "group")
+	require.Len(t, group.Tasks, 1)
+	assert.Equal(t, filepath.Join(dir, "sub"), group.Tasks[0].WorkingDir)
+	assert.Equal(t, dir, findTask(t, cfg.Tasks, "root1").WorkingDir)
+}
+
+func TestLoad_diamondIncludeIsDeduplicated(t *testing.T) {
+	dir := t.TempDir()
+	root := filepath.Join(dir, "cmdx.yaml")
+	writeFile(t, root, `---
+includes:
+- a.yaml
+- b.yaml
+tasks:
+- name: root1
+  script: echo root
+`)
+	writeFile(t, filepath.Join(dir, "a.yaml"), `---
+includes:
+- d.yaml
+tasks:
+- name: a1
+  script: echo a
+`)
+	writeFile(t, filepath.Join(dir, "b.yaml"), `---
+includes:
+- d.yaml
+tasks:
+- name: b1
+  script: echo b
+`)
+	writeFile(t, filepath.Join(dir, "d.yaml"), `---
+tasks:
+- name: d1
+  script: echo d
+`)
+
+	cfg, err := New().Load(root)
+	require.NoError(t, err)
+	// d.yaml is identified by its normalized real path and contributes only
+	// once, at the position where it is first encountered.
+	assert.Equal(t, []string{"d1", "a1", "b1", "root1"}, taskNames(cfg.Tasks))
+}
+
+func TestLoad_fileLevelDefaultsDoNotLeak(t *testing.T) {
+	dir := t.TempDir()
+	root := filepath.Join(dir, "cmdx.yaml")
+	writeFile(t, root, `---
+environment:
+  ROOT_V: root
+input_envs:
+- ROOTENV
+script_envs:
+- ROOTSCRIPT
+timeout:
+  duration: 12
+  kill_after: 3
+quiet: true
+includes:
+- a.yaml
+- b.yaml
+tasks:
+- name: roottask
+  script: echo root
+  flags:
+  - name: src
+`)
+	writeFile(t, filepath.Join(dir, "a.yaml"), `---
+environment:
+  A_V: a
+input_envs:
+- AENV
+timeout:
+  duration: 34
+quiet: false
+tasks:
+- name: atask
+  script: echo a
+  flags:
+  - name: path
+- name: group
+  tasks:
+  - name: nested
+    script: echo nested
+`)
+	writeFile(t, filepath.Join(dir, "b.yaml"), `---
+tasks:
+- name: btask
+  script: echo b
+  flags:
+  - name: file
+`)
+
+	cfg, err := New().Load(root)
+	require.NoError(t, err)
+
+	rootTask := findTask(t, cfg.Tasks, "roottask")
+	assert.Equal(t, map[string]string{"ROOT_V": "root"}, rootTask.Environment)
+	require.Len(t, rootTask.Flags, 1)
+	assert.Equal(t, []string{"ROOTENV"}, rootTask.Flags[0].InputEnvs)
+	assert.Equal(t, []string{"ROOTSCRIPT"}, rootTask.Flags[0].ScriptEnvs)
+	assert.Equal(t, 12, rootTask.Timeout.Duration)
+	assert.Equal(t, 3, rootTask.Timeout.KillAfter)
+	require.NotNil(t, rootTask.Quiet)
+	assert.True(t, *rootTask.Quiet)
+
+	aTask := findTask(t, cfg.Tasks, "atask")
+	// The root file level defaults and sibling file's defaults don't leak.
+	assert.Equal(t, map[string]string{"A_V": "a"}, aTask.Environment)
+	require.Len(t, aTask.Flags, 1)
+	assert.Equal(t, []string{"AENV"}, aTask.Flags[0].InputEnvs)
+	assert.Equal(t, 34, aTask.Timeout.Duration)
+	assert.Equal(t, 0, aTask.Timeout.KillAfter)
+	require.NotNil(t, aTask.Quiet)
+	assert.False(t, *aTask.Quiet)
+
+	// Nested tasks inherit the defaults of the file that declares them.
+	group := findTask(t, cfg.Tasks, "group")
+	require.Len(t, group.Tasks, 1)
+	nested := group.Tasks[0]
+	assert.Equal(t, map[string]string{"A_V": "a"}, nested.Environment)
+	assert.Equal(t, 34, nested.Timeout.Duration)
+	require.NotNil(t, nested.Quiet)
+	assert.False(t, *nested.Quiet)
+
+	// A file without file level defaults gets the builtin defaults.
+	bTask := findTask(t, cfg.Tasks, "btask")
+	assert.Equal(t, map[string]string{}, bTask.Environment)
+	assert.Equal(t, defaultTimeout, bTask.Timeout.Duration)
+	assert.Nil(t, bTask.Quiet)
+	require.Len(t, bTask.Flags, 1)
+	assert.Empty(t, bTask.Flags[0].InputEnvs)
+}
+
+func TestLoad_sameFileViaSymlinkIsLoadedOnce(t *testing.T) {
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, "realdir", "d.yaml"), `---
+tasks:
+- name: d1
+  script: echo d
+`)
+	if err := os.Symlink(filepath.Join(dir, "realdir"), filepath.Join(dir, "alias")); err != nil {
+		t.Skipf("creating a symlink is unsupported: %v", err)
+	}
+	root := filepath.Join(dir, "cmdx.yaml")
+	writeFile(t, root, `---
+includes:
